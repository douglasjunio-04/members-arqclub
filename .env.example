# ======= Deploy Vercel — TanStack Start XSS check bypass =======
# Desbloqueia builds do TanStack Start com versões ainda não reconhecidas
# como "patched" pelo detector de vulnerabilidades da Vercel.
# Normalmente NÃO é necessário quando @tanstack/react-start >= 1.168.30+.
# Só defina como 1 em último caso (risco de aceitar deployar versões antigas).
DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS=0
